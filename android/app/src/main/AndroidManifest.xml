<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- calls (data/Calls.kt): the sound's route (earpiece / speaker), ringing over the lock screen, a call that
         goes on in the background (CallService), the screen off at the ear -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- usesCleartextTraffic: the prototype talks plain HTTP to the PC in the LAN. -->
    <application
        android:name=".MomentumApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Momentum"
        android:supportsRtl="false"
        android:theme="@style/Theme.Momentum"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- a call that goes on while the app is in the background (data/CallService.kt) -->
        <service android:name=".data.CallService" android:exported="false"
            android:foregroundServiceType="microphone|camera" />
        <!-- decline / hang up from a call's notification -->
        <receiver android:name=".data.CallActionReceiver" android:exported="false" />

        <!-- push from the server (data/Push.kt): wakes the app to check for news -->
        <service android:name=".data.MomentumMessagingService" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- no automatic EmojiCompat: it would replace emojis with its own pictures instead of the pixel font
             (MomentumApplication starts it only on Android 8/9) -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data android:name="androidx.emoji2.text.EmojiCompatInitializer" tools:node="remove" />
        </provider>

        <!-- camera captures are handed to the camera app through this provider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- home screen widgets (widget/Widgets.kt) -->
        <receiver android:name=".widget.MomentumWidget" android:exported="false" android:label="Momentum">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_momentum" />
        </receiver>
        <receiver android:name=".widget.MiniWidget" android:exported="false" android:label="Momentum · Klein">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_mini" />
        </receiver>
        <receiver android:name=".widget.OverviewWidget" android:exported="false" android:label="Momentum · Übersicht">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_overview" />
        </receiver>
        <receiver android:name=".widget.GroupRankingWidget" android:exported="false" android:label="Momentum · Gruppen-Rangliste">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_group_ranking" />
        </receiver>
        <receiver android:name=".widget.GroupDeltaWidget" android:exported="false" android:label="Momentum · Gruppen-Rangliste heute">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_group_delta" />
        </receiver>
        <receiver android:name=".widget.FriendsDeltaWidget" android:exported="false" android:label="Momentum · Freunde-Rangliste heute">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_friends_delta" />
        </receiver>
        <receiver android:name=".widget.FriendsRankingWidget" android:exported="false" android:label="Momentum · Freunde-Rangliste">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_friends_ranking" />
        </receiver>
        <!-- picks the group of a group-ranking widget -->
        <activity android:name=".widget.GroupWidgetConfigActivity" android:exported="true" android:theme="@style/Theme.Momentum">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>
        <receiver android:name=".widget.TodayWidget" android:exported="false" android:label="Momentum · Heute">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_today" />
        </receiver>
        <receiver android:name=".widget.QuickWidget" android:exported="false" android:label="Momentum · Tippen">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_quick" />
        </receiver>
    </application>
</manifest>
