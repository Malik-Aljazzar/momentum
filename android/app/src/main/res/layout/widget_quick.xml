<?xml version="1.0" encoding="utf-8"?>
<!-- Four rule buttons, each a pixel-art bitmap. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">
    <ImageView android:id="@+id/quick_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="fitCenter" android:contentDescription="1" />
    <ImageView android:id="@+id/quick_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="fitCenter" android:contentDescription="2" />
    <ImageView android:id="@+id/quick_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="fitCenter" android:contentDescription="3" />
    <ImageView android:id="@+id/quick_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="fitCenter" android:contentDescription="4" />
</LinearLayout>
