{
  "id": "journal",
  "version": "1.1.0",
  "api": 1,
  "name": { "de": "Tagebuch", "en": "Journal" },
  "description": {
    "de": "Ein paar Zeilen am Tag und wie es dir ging – zwei Tabs: „Heute“ zum Schreiben, „Einträge“ zum Zurückblättern. Nur du siehst es.",
    "en": "A few lines a day and how you felt – two tabs: \"Today\" to write, \"Entries\" to look back. Only you can see it."
  },
  "author": "Momentum",
  "icon": "openbook",
  "tabs": [
    { "key": "today", "name": { "de": "Heute", "en": "Today" }, "icon": "tab_pen" },
    { "key": "entries", "name": { "de": "Einträge", "en": "Entries" }, "icon": "tab_book" }
  ],
  "entry": "index.html",
  "collections": {
    "entries": {
      "key_pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "max_docs": 4000,
      "schema": {
        "type": "object",
        "required": ["text"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string", "maxLength": 2000 },
          "mood": { "type": "integer", "minimum": 1, "maximum": 5 }
        }
      }
    }
  }
}
