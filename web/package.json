{
  "name": "momentum-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Momentum as a PWA (iOS and any browser) - mirrors the Android app in ../android",
  "scripts": {
    "assets": "node scripts/assets.mjs",
    "strings": "node scripts/strings.mjs",
    "predev": "npm run assets && npm run strings",
    "dev": "vite",
    "prebuild": "npm run assets && npm run strings",
    "build": "tsc --noEmit && vite build",
    "test": "npm run strings && vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@preact/signals": "2.11.3",
    "mediabunny": "1.62.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.15.21",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vitest": "3.2.7"
  }
}
